# Copy to .env and fill in. .env is git-ignored: never commit a real key.

# Groq (free tier): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=

# Gemini instead (free tier, OpenAI-compatible endpoint):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
# Local Ollama instead (no key needed, any non-empty value):
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama

JWT_SECRET=change-me
# Freeze "now" for a repeatable demo (empty = real time)
DEMO_TIME=17:00
# Simulate a failing tool, e.g. FAULTS=check_cab_options
FAULTS=
